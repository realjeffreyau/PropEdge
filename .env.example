# Copy this file to .env for local development. Never commit real values.

# Prisma/Postgres. Required for db:generate, db:push, db:seed, auth, and
# database-backed user/cache features. Use the connection string supplied by
# your Supabase project when deploying.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# NextAuth/Auth.js v5. Required in production. Generate a long random value,
# for example: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-value"

# Optional Auth.js v5 deployment settings.
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Used to build invite links. The application defaults to localhost when this
# is empty, but set it to the public URL in deployment.
APP_BASE_URL="http://localhost:3000"

# Optional. Leave empty to use local mock odds and make no provider requests.
THE_ODDS_API_KEY=""

# Optional The Odds API request settings.
ODDS_API_REGION="us"
ODDS_API_BOOKMAKERS="draftkings,fanduel,betmgm,williamhill_us,espnbet,fanatics"
ODDS_API_DFS_BOOKMAKERS="underdog,prizepicks,pick6,betr_us_dfs"

# Optional seed settings. Set both to create an active admin with a password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# NODE_ENV is assigned by Next.js/Node for each command; do not normally set
# it here. This project documents AUTH_* names and does not require NEXTAUTH_*
# aliases or a separate DIRECT_URL setting.
